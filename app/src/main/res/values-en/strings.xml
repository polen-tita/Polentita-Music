    <string name="playlist_import_choose_file">Choose JSON, CSV, or TXT</string>
    <string name="playlist_import_help_button_description">Information about JSON, CSV, and TXT</string>
    <string name="playlist_import_help_title">How to complete a large playlist</string>
    <string name="playlist_import_help_subtitle">Guide to exporting songs that do not appear in the link</string>
    <string name="playlist_import_help_intro">If a playlist exceeds the provider limit or the public link does not show all its songs, export the complete list as JSON, CSV, or TXT and select it here.</string>
    <string name="playlist_import_help_limits_title">Limits and behavior</string>
    <string name="playlist_import_help_spotify_title">Spotify</string>
    <string name="playlist_import_help_spotify_limit">Polentita analyzes up to 100 songs per public link. If your playlist has more, it analyzes the first 100 and you can complete the rest with JSON, CSV, or TXT.</string>
    <string name="playlist_import_help_youtube_title">YouTube and YouTube Music</string>
    <string name="playlist_import_help_youtube_limit">There is no fixed limit in Polentita: it imports the public songs that yt-dlp can read. Private, deleted, or unavailable songs may be left out; a structured file is the most complete way to keep them.</string>
    <string name="playlist_import_help_tidal_title">TIDAL</string>
    <string name="playlist_import_help_tidal_limit">TIDAL is queried in public pages of 100 songs until the collection is complete. If the provider does not expose part of the playlist, use JSON, CSV, or TXT to complete the analysis.</string>
    <string name="playlist_import_help_guide_title">Quick guide</string>
    <string name="playlist_import_help_exportify_steps">1. Open Exportify, sign in with your Spotify account, find the playlist, and tap CSV or JSON to download it.</string>
    <string name="playlist_import_help_tunemymusic_steps">2. Alternatively, open TuneMyMusic, choose Spotify as the source, sign in, select the playlist, and export it as CSV or TXT.</string>
    <string name="playlist_import_help_import_steps">3. Return to Polentita, tap Choose JSON, CSV, or TXT, and select the downloaded file. Review matches before confirming any download.</string>
    <string name="playlist_import_help_security">Sign-in happens on the external site. Polentita does not receive your password or store tokens: it only reads the file you choose to import.</string>
    <string name="playlist_import_help_exportify_image_description">Reference image of the Exportify panel with CSV and JSON buttons</string>
    <string name="playlist_import_help_tunemymusic_image_description">Reference image of TuneMyMusic for exporting Spotify to CSV or a text file</string>
    <string name="playlist_import_help_image_note">Reference image; the site interface may change.</string>
